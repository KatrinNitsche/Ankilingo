@using AnkiLingo.Data
@using AnkiLingoApp.Helpers
@using AnkiLingoApp.Models
@using AnkiLingoExcelService
@using AnkiLingoExcelService.Data

@if (Show && questions != null && questions.Count() > 0)
{
    <div class="modal-overlay">
        <div class="modal-content" style="background-color: white; border-radius: 10px;">
            <h2>@Title - Question: @currentQuestionIndex of @questions.Count()</h2>

            @if (revealAnswer)
            {
                <div class="alert alert-info">
                    <strong>Answer:</strong> @textToReveal
                </div>
            }

            <hr />
            @{
                if (showSummary)
                {
                    <h3 class="text-center">Congratulations! You have completed the lesson.</h3>

                    <p class="text-center">XP: @xp</p>

                    <p class="text-center">
                        Your performance:
                        @if (questions.Count > 0)
                        {
                            var percentage = (double)correctAnswersCount / (correctAnswersCount + incorrectAnswersCount) * 100;
                            <span class="text-success">@percentage.ToString("0")%</span>
                        }
                        else
                        {
                            <span class="text-danger">No questions answered.</span>
                        }
                    </p>

                    <p class="text-center">
                        Time take:
                        @if (endTime < startTime)
                        {
                            <span class="text-danger">Error calculating time.</span>
                        }
                        else
                        {
                            var duration = endTime - startTime;
                            <span>@duration.Hours.ToString("00"):@duration.Minutes.ToString("00"):@duration.Seconds.ToString("00")</span>
                        }
                    </p>
                }
                else
                {
                    Question entry = questions.ElementAt(currentQuestionIndex);
                    switch (entry.QuestionType)
                    {
                        case QuestionType.MultipleChoiceValue1:
                        case QuestionType.MultipleChoiceValue2:
                            <div class="multiple-choice">
                                <h3 class="text-center">@entry.QuestionText</h3>
                                <br />
                                <div class="multiple-choice-questions">
                                    @foreach (var answerOption in entry.Options)
                                    {
                                        <button class="btn btn-question w-25" @onclick="() => CheckAnswer(answerOption, true)">@answerOption</button>
                                    }
                                </div>
                            </div>
                            break;
                        case QuestionType.InputValue1:
                        case QuestionType.InputValue2:
                            <div class="input-question">
                                <h3 class="text-center">@entry.QuestionText</h3>
                                <br />
                                <input type="text" class="form-control w-50 m-auto" @bind="entry.UserAnswer" placeholder="Type your answer here..." />
                                <button class="btn btn-primary mt-2" @onclick="() => CheckAnswer(entry.UserAnswer, false)">Submit Answer</button>
                            </div>
                            break;
                        case QuestionType.ListModelValue1:
                        case QuestionType.ListModelValue2:
                            <div class="list-mode">
                                <div class="row">
                                    <div class="col">
                                        @foreach (var leftValue in entry.LeftValues)
                                        {
                                            if (leftEntriesRemoved.Contains(leftValue)) continue; // Skip removed entries
                                                                                                  <button class="btn btn-@((selectedLeftValue == leftValue) ? "primary" : "secondary") w-100 mb-1" @onclick="() => SelectLeft(leftValue)">@leftValue</button>
                                        }
                                    </div>
                                    <div class="col">
                                        @foreach (var rightValue in entry.RightValues)
                                        {
                                            if (rightEntriesRemoved.Contains(rightValue)) continue; // Skip removed entries
                                                                                                    <button class="btn btn-@((selectedRightValue == rightValue) ? "primary" : "secondary") w-100 mb-1" @onclick="() => SelectRight(rightValue)"> @rightValue</button>
                                        }
                                    </div>
                                </div>
                            </div>
                            break;
                        // case QuestionType.Image:
                        //     <div class="image-question text-center">

                        //         <div class="d-flex flex row justify-content-between">

                        //             @if (entry.ImageWords.Any(x => x.WasChecked == false))
                        //             {
                        //                 <div class="image-canvas-container w-50">
                        //                     <img id="mainImage" src="@entry.Value2" alt="@entry.Value2"
                        //                          style="max-width: 100%; max-height: 100%;" />
                        //                 </div>
                        //             }
                        //             else
                        //             {
                        //                 <div class="image-canvas-container w-50">
                        //                     <img id="mainImage" src="@entry.Value1" alt="@entry.Value1"
                        //                          style="max-width: 100%; max-height: 100%;" />
                        //                 </div>
                        //             }
                        //             <ul class="d-flex flex-grid w-50" style="height: 500px; overflow: scroll;">
                        //                 @foreach (var cover in entry.ImageWords)
                        //                 {
                        //                     <li class="active list-group-item" style="@StyleForImageCover(cover)">
                        //                         @if (!cover.WasChecked)
                        //                         {
                        //                             <input type="number" class="w-50" @bind="cover.UserInput" />
                        //                             <br />
                        //                         }
                        //                         @cover.Value.Value1
                        //                     </li>
                        //                 }
                        //             </ul>
                        //         </div>

                        //         @if (entry.ImageWords.Any(x => x.WasChecked == false))
                        //         {
                        //             <button class="btn btn-primary mt-2" @onclick="CheckImageAnswers">Check My Answers</button>
                        //         }

                        //         <button class="btn btn-primary mt-2" @onclick="NextQuestion">Next Question</button>


                        //     </div>

                        //     break;
                        default:
                            <div class="alert alert-danger">
                                <strong>Error:</strong> Unknown question type.
                            </div>
                            break;
                    }
                }
            }
            <hr />
            <button class="btn btn-primary w-25" @onclick="CloseModal">Close</button>
        </div>
    </div>
}

@code {
    [Parameter] public string Title { get; set; } = "Study Lesson";
    [Parameter] public List<EntryData> Entries { get; set; } = new List<EntryData>();
    [Parameter] public List<ImageData> Images { get; set; } = new List<ImageData>();
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<EntryData> OnUpdateEntry { get; set; }
    [Inject] private ISoundPlayer soundPlayer { get; set; }
    [Parameter] public CourseData CurrentCourse { get; set; }
    [Parameter] public string currentSection { get; set; }
    [Parameter] public string currentUnit { get; set; }

    private List<Question> questions = new List<Question>();
    private int currentQuestionIndex = 0;
    private int correctAnswersCount = 0;
    private int incorrectAnswersCount = 0;
    private string selectedLeftValue;
    private string selectedRightValue;
    private bool started = false;
    private TimeOnly startTime = TimeOnly.FromDateTime(DateTime.Now);
    private TimeOnly endTime = TimeOnly.FromDateTime(DateTime.Now);
    private bool showSummary = false;
    private int xp = 0;
    private bool revealAnswer = false;
    private string textToReveal = string.Empty;

    private List<string> leftEntriesRemoved = new List<string>();
    private List<string> rightEntriesRemoved = new List<string>();
    private bool needsImageRedraw = false;

    protected override void OnParametersSet()
    {
        if (Entries.Count() == 0 || started) return;
        SetQuestions();
    }

    public async Task SetQuestions()
    {
        questions.Clear();
        Entries = Entries.OrderBy(e => Guid.NewGuid()).ToList();

        if (Images != null && Images.Count() > 0)
        {
            foreach (var img in Images)
            {
                questions.Add(new Question
                {
                    Value1 = $"images/{img.ImageName}.jpg",
                    Value2 = $"images/{img.ImageName} IndexDisplay.jpg",
                    QuestionText = $"What does this image represent?",
                    AnswerText = img.ImageName,
                    LevelOfKnowledge = 0,
                    LastReviewed = DateTime.Now,
                    QuestionType = QuestionType.Image,
                    Options = new List<string>(),
                    LeftValues = new List<string>(),
                    RightValues = new List<string>(),
                    //ImageWords = img.ImageCovers.OrderBy(i => Guid.NewGuid()).ToList()
                });
            }
        }

        foreach (var entry in Entries)
        {
            var questionType = GetRandomQuestionTypeFromEnum();
            var possibleAnswers = new List<string>();
            var questionText = entry.Value1; // Default question text
            var answerText = entry.Value2; // Default answer text
            var difficultyLevel = 3;
            var leftEntries = new List<string>();
            var rightEntries = new List<string>();
            if (entry.LevelOfKnowledge > 3) difficultyLevel = 4;

            switch (questionType)
            {
                case QuestionType.MultipleChoiceValue1:
                    questionText = entry.Value2; // Use Value2 as the question text
                    answerText = entry.Value1; // Use Value1 as the answer text
                    possibleAnswers = Entries.Where(e => e != entry).OrderBy(e => Guid.NewGuid()).Take(difficultyLevel).Select(x => x.Value1).ToList();
                    possibleAnswers.Add(entry.Value1);  // Add the correct answer to the options
                    break;

                case QuestionType.MultipleChoiceValue2:
                    questionText = entry.Value1; // Use Value1 as the question text
                    answerText = entry.Value2; // Use Value2 as the answer text
                    possibleAnswers = Entries.Where(e => e != entry).OrderBy(e => Guid.NewGuid()).Take(difficultyLevel).Select(x => x.Value2).ToList();
                    possibleAnswers.Add(entry.Value2);  // Add the correct answer to the options

                    // shuffle the possible options
                    possibleAnswers = possibleAnswers.OrderBy(o => Guid.NewGuid()).ToList();
                    break;

                case QuestionType.InputValue1:
                    questionText = entry.Value2; // Use Value2 as the question text
                    answerText = entry.Value1; // Use Value1 as the answer text
                    break;
                case QuestionType.InputValue2:
                    questionText = entry.Value1; // Use Value1 as the question text
                    answerText = entry.Value2; // Use Value2 as the answer text
                    break;
                case QuestionType.ListModelValue1:
                    var listEntries = Entries.Where(e => e != entry).OrderBy(e => Guid.NewGuid()).Take(5).ToList();
                    foreach (var leftEntry in listEntries)
                    {
                        var leftValue = leftEntry.Value1;
                        var rightEntry = Entries.FirstOrDefault(e => e.Value1 == leftEntry.Value1).Value2;
                        leftEntries.Add(leftValue);
                        rightEntries.Add(rightEntry);
                    }
                    break;
                case QuestionType.ListModelValue2:
                    var listEntries2 = Entries.Where(e => e != entry).OrderBy(e => Guid.NewGuid()).Take(5).ToList();
                    foreach (var leftEntry in listEntries2)
                    {
                        var leftValue = leftEntry.Value2;
                        var rightEntry = Entries.FirstOrDefault(e => e.Value2 == leftEntry.Value2).Value1;
                        leftEntries.Add(leftValue);
                        rightEntries.Add(rightEntry);
                    }
                    break;
            }
            // shuffle the left and right entries
            leftEntries = leftEntries.OrderBy(o => Guid.NewGuid()).ToList();
            rightEntries = rightEntries.OrderBy(o => Guid.NewGuid()).ToList();

            questions.Add(new Question
            {
                Value1 = entry.Value1,
                Value2 = entry.Value2,
                EntryData = entry,
                QuestionText = questionText,
                AnswerText = answerText,
                LevelOfKnowledge = entry.LevelOfKnowledge,
                LastReviewed = entry.LastReviewed,
                QuestionType = questionType,
                Options = possibleAnswers,
                LeftValues = leftEntries,
                RightValues = rightEntries
            });
        }

        started = true;
        startTime = TimeOnly.FromDateTime(DateTime.Now);

        // shuffle the questions
        questions = questions.OrderBy(q => Guid.NewGuid()).ToList();

        // Set flag instead of calling JS directly
        needsImageRedraw = questions.Any(q => q.QuestionType == QuestionType.Image);
        StateHasChanged();
    }

    private QuestionType GetRandomQuestionTypeFromEnum()
    {
        var questionTypes = Enum.GetValues(typeof(QuestionType)).Cast<QuestionType>().ToList();
        var weightedTypes = new List<QuestionType>();
        // Add the first 4 question types more frequently
        for (int z = 0; z < 4; z++)
        {
            for (int i = 0; i < 4; i++)
            {
                weightedTypes.Add(questionTypes[i]);
            }
        }

        // Add the rest of the question types once (leave out the last which is Image)
        for (int i = 4; i < questionTypes.Count - 1; i++)
        {
            weightedTypes.Add(questionTypes[i]);
        }
        // Shuffle the list to ensure randomness
        weightedTypes = weightedTypes.OrderBy(x => Guid.NewGuid()).ToList();
        // Return a random question type from the shuffled list
        return weightedTypes[new Random().Next(weightedTypes.Count)];
    }

    private void CheckAnswer(string selectedAnswer, bool compareComplete)
    {
        var currentQuestion = questions[currentQuestionIndex];
        if ((!compareComplete && (currentQuestion.Options.Contains(selectedAnswer) || currentQuestion.AnswerText.ToLower().Contains(selectedAnswer.ToLower()))) ||
            (compareComplete && currentQuestion.AnswerText.Equals(selectedAnswer)))
        {
            // Correct answer logic
            soundPlayer.Play("audio/correct.mp3");
            OnUpdateEntry.InvokeAsync(new EntryData
            {
                Value1 = currentQuestion.Value1,
                Value2 = currentQuestion.Value2,
                CourseId = currentQuestion.EntryData.CourseId,
                SectionId = currentQuestion.EntryData.SectionId,
                UnitId = currentQuestion.EntryData.UnitId,
                ReviewCount = currentQuestion.EntryData.ReviewCount,
                LevelOfKnowledge = currentQuestion.LevelOfKnowledge + 1,
                LastReviewed = DateTime.Now
            });
            correctAnswersCount++;
            xp += 2;
        }
        else
        {
            // Incorrect answer logic
            soundPlayer.Play("audio/wrong.mp3");
            RevealAnswerForXSeceonds(3, currentQuestion.AnswerText); // Reveal the answer for 3 seconds
            OnUpdateEntry.InvokeAsync(new EntryData
            {
                Value1 = currentQuestion.Value1,
                Value2 = currentQuestion.Value2,
                CourseId = currentQuestion.EntryData.CourseId,
                SectionId = currentQuestion.EntryData.SectionId,
                UnitId = currentQuestion.EntryData.UnitId,
                ReviewCount = currentQuestion.EntryData.ReviewCount,
                LevelOfKnowledge = Math.Max(currentQuestion.LevelOfKnowledge - 1, 0),
                LastReviewed = DateTime.Now
            });
            incorrectAnswersCount++;
            xp -= 2;
        }

        currentQuestionIndex++;
        if (currentQuestionIndex >= questions.Count)
        {
            FinishLesson();
        }

        StateHasChanged();
    }

    private void NextQuestion()
    {
        currentQuestionIndex++;
        if (currentQuestionIndex >= questions.Count)
        {
            FinishLesson();
        }
        StateHasChanged();

    }

    private void SelectLeft(string leftValue)
    {
        selectedLeftValue = leftValue;
        if (!string.IsNullOrEmpty(selectedRightValue))
        {
            CheckListAnswer();
        }
    }

    private void SelectRight(string rightValue)
    {
        selectedRightValue = rightValue;
        if (!string.IsNullOrEmpty(selectedLeftValue))
        {
            CheckListAnswer();
        }
    }

    private void CheckListAnswer()
    {
        var currentEntry = Entries.FirstOrDefault(e => e.Value1 == selectedLeftValue || e.Value2 == selectedRightValue || e.Value2 == selectedLeftValue || e.Value2 == selectedLeftValue);
        // check if there is a correct combination of left and right value in the Entries list for Value1 and Value2
        var checkIfAnswerIsCorrect = Entries.Any(e => (e.Value1 == selectedLeftValue && e.Value2 == selectedRightValue) ||
                                                      (e.Value1 == selectedRightValue && e.Value2 == selectedLeftValue));

        leftEntriesRemoved.Add(selectedLeftValue);
        rightEntriesRemoved.Add(selectedRightValue);

        var Value1Entry = currentEntry.Value1;
        var Value2Entry = currentEntry.Value2;
        if (questions.ElementAt(currentQuestionIndex).QuestionType == QuestionType.MultipleChoiceValue2)
        {
            Value1Entry = currentEntry.Value2;
            Value2Entry = currentEntry.Value1;
        }

        if (checkIfAnswerIsCorrect)
        {
            // Correct answer logic
            correctAnswersCount++;
            xp += 2;
            soundPlayer.Play("audio/correct.mp3");
            OnUpdateEntry.InvokeAsync(new EntryData
            {
                Value1 = Value1Entry,
                Value2 = Value2Entry,
                CourseId = currentEntry.CourseId,
                SectionId = currentEntry.SectionId,
                UnitId = currentEntry.UnitId,
                ReviewCount = currentEntry.ReviewCount,
                LevelOfKnowledge = currentEntry.LevelOfKnowledge + 1,
                LastReviewed = DateTime.Now
            });
        }
        else
        {
            // Incorrect answer logic
            incorrectAnswersCount++;
            xp -= 2;
            soundPlayer.Play("audio/wrong.mp3");
            OnUpdateEntry.InvokeAsync(new EntryData
            {
                Value1 = Value1Entry,
                Value2 = Value2Entry,
                CourseId = currentEntry.CourseId,
                SectionId = currentEntry.SectionId,
                UnitId = currentEntry.UnitId,
                ReviewCount = currentEntry.ReviewCount,
                LevelOfKnowledge = Math.Max(currentEntry.LevelOfKnowledge - 1, 0),
                LastReviewed = DateTime.Now
            });

        }
        selectedLeftValue = null;
        selectedRightValue = null;
        StateHasChanged();

        if (leftEntriesRemoved.Count >= questions.ElementAt(currentQuestionIndex).LeftValues.Count())
        {
            if (currentQuestionIndex >= questions.Count)
            {
                FinishLesson();
            }
            else
            {
                currentQuestionIndex++;
            }
        }
    }

