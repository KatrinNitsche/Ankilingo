    private string StyleForImageCover(ImageWord question)
    {
        if (!question.WasChecked)
        {
            return "background-color: lightgray;";
        }

        return $"background-color: {(question.WasChecked && question.Id == question.UserInput ? "green" : "red")};";
    }

    private async Task RevealAnswerForXSeceonds(int seconds, string text)
    {
        revealAnswer = true;
        textToReveal = text;
        StateHasChanged();
        await Task.Delay(seconds * 1000);
        revealAnswer = false;
        StateHasChanged();
    }

    private void FinishLesson()
    {
        currentQuestionIndex++;
        leftEntriesRemoved.Clear();
        rightEntriesRemoved.Clear();

        endTime = TimeOnly.FromDateTime(DateTime.Now);
        showSummary = true;

        var duration = endTime - startTime;
        var timeOnly = new TimeOnly(duration.Hours, duration.Minutes, duration.Seconds);

        // update user data
        var filePaht = @"C:\temp\AnkiLingo\Data\UserData.xlsx";
        ExcelService.UpdateUserData(filePaht, null, xp, timeOnly);

        StateHasChanged();
    }

    private void CloseModal()
    {
        Show = false;
        StateHasChanged();
        if (OnClose.HasDelegate)
        {
            OnClose.InvokeAsync();
        }
    }
