@using AnkiLingo.Data
@using AnkiLingoBackendService
@using AnkiLingoExcelService
@using AnkiLingoExcelService.Data
@using Microsoft.AspNetCore.Components.Forms

<div id="top-navigation-container">
    <div class="top-nav">

        @if (currentCourse != null)
        {
            <div class="top-nav-item" @onclick="ShowCourseList">
                <img src=@currentCourseIconPath alt="Course" class="top-nav-icon" />
                <span class="top-nav-value">@currentCourse.Name</span>
            </div>
        }
        else
        {
            <div class="top-nav-item">
                <img src="images/course.png" alt="Course" class="top-nav-icon" />
                <span class="top-nav-value">Loading...</span>
            </div>
        }

        @if (streakActive())
        {
            <div class="top-nav-item" @onclick="ShowStreak">
                <img src="images/streak.png" alt="Streak" class="top-nav-icon" />
                <span class="top-nav-value">@streakCount</span>
            </div>
        }
        else
        {
            <div class="top-nav-item">
                <img src="images/streak-non.png" alt="Flame" class="top-nav-icon" />
                <span class="top-nav-value">@streakCount</span>
            </div>
        }

        <div class="top-nav-item" @onclick="ShowGems">
            <img src="images/gem.png" alt="Gems" class="top-nav-icon" />
            <span class="top-nav-value">@gemsCount</span>
        </div>
        <div class="top-nav-item" @onclick="ShowXP">
            <img src="images/train.png" alt="XP" class="top-nav-icon" />
            <span class="top-nav-value">@xpCount</span>
        </div>
    </div>
</div>

@if (ShowCourseListDiv)
{
    <div class="modal-overlay">
        <div class="modal-content" style="background-color: white; border-radius: 10px;">
            <h2>Available Courses</h2>

            <ul class="course-list">
                @if (courseList != null && courseList.Count() > 0)
                {
                    @foreach (string course in courseList.ToList())
                    {
                        <li class="course-list-entry" @onclick="() => SetCurrentCourse(course)"> <img src="@GetCourseIconPath(course)" alt="Course" class="top-nav-icon" /> @course</li>
                    }
                }
                <li class="course-list-entry" @onclick="AddNewCourse">Add New Course</li>
            </ul>

            @if (ShowAddCourseDiv)
            {
                <div class="border w-50 m-auto">
                    <h3>Add New Course</h3>
                    <p>upload an excel file with a valid structure for the course information</p>
                    <InputFile OnChange="OnCourseFileChange" />
                    <InputText @bind-Value="FilePath" placeholder="File Path" class="form-control mt-2" />
                    <button class="btn btn-primary" @onclick="UploadCourseFile">Upload</button>
                    <button class="btn btn-secondary" @onclick="() => ShowAddCourseDiv = false">Cancel</button>
                </div>
            }

            <button class="close-button" @onclick="HideCourseList">Close</button>
        </div>
    </div>
}

@code {
    [Parameter] public Guid userId { get; set; }
    [Parameter] public int streakCount { get; set; }
    [Parameter] public int gemsCount { get; set; }
    [Parameter] public DateTime lastStudyDatetime { get; set; }
    [Parameter] public int xpCount { get; set; }
    [Parameter] public CourseData currentCourse { get; set; }
    [Parameter] public IEnumerable<string> courseList { get; set; } = new List<string>();

    private bool streakActive() => (lastStudyDatetime > DateTime.Now.AddHours(-48));
    private bool ShowCourseListDiv;
    private bool ShowAddCourseDiv = false;
    private IBrowserFile? courseFile;
    private string FilePath = string.Empty;

    [Parameter] public EventCallback<string> OnCourseChanged { get; set; }
    [Inject] public IDatabaseService databaseService { get; set; }
    private string currentCourseIconPath => currentCourse != null ? $"images/icons/{currentCourse.Icon}.png" : "images/course.png";

    void ShowStreak() { /* Reveal streak details below */ }
    void ShowGems() { /* Reveal gems details below */ }
    void ShowXP() { /* Reveal hearts details below */ }
    
    void ShowCourseList()
    {
        ShowCourseListDiv = true;
    }

    void HideCourseList()
    {
        ShowCourseListDiv = false;
    }

    void SetCurrentCourse(string courseName)
    {
        OnCourseChanged.InvokeAsync(courseName);
        HideCourseList();
    }

    void AddNewCourse()
    {
        ShowAddCourseDiv = true;
        StateHasChanged();
    }

    void OnCourseFileChange(InputFileChangeEventArgs e)
    {
        courseFile = e.File;
    }

    async Task UploadCourseFile()
    {

        var courseData = null as CourseData;
        if (FilePath == string.Empty)
        {
            courseData = ExcelService.LoadCourseFromExcel(courseFile);
        }
        else if (courseFile != null)
        {
            return;
        }
        else
        {
            courseData = ExcelService.GetCourseDetails(FilePath);
        }

        if (courseData != null)
        {
            var sectionList = new List<Section>();
            foreach (var section in courseData.Sections)
            {
                var newSection = new Section
                {
                    Name = section.Name,
                    Created = DateTime.Now,
                    Updated = DateTime.Now,
                    Units = section.Units.Select(u => new Unit
                    {
                        Name = u.Name,
                        Created = DateTime.Now,
                        Updated = DateTime.Now,
                        Entries = u.Entries.Select(e => new AnkiLingo.Data.Entry
                        {
                            Name = e.Value1,
                            Value1 = e.Value1,
                            Value2 = e.Value2,
                            Description = e.Value1,
                            Created = DateTime.Now,
                            Updated = DateTime.Now
                        }).ToList()
                    }).ToList()
                };
                sectionList.Add(newSection);
            }

            var courseToAdd = new Course
            {
                Name = courseData.Name,
                Icon = courseData.Icon,
                Description = courseData.Description,
                Created = DateTime.Now,
                Updated = DateTime.Now,
                Sections = sectionList
            };

            await databaseService.AddCourse(courseToAdd);
            await OnCourseChanged.InvokeAsync(courseToAdd.Name);
            ShowAddCourseDiv = false;
            HideCourseList();
        }
    }

    string GetCourseIconPath(string courseName)
    {
        var course = databaseService.GetCourseDetails(userId, courseName).Result;
        return course != null ? $"images/icons/{course.Icon}.png" : "images/course.png";
    }
}
