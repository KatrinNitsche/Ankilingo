@page "/bootcamp"
@rendermode InteractiveServer
@using AnkiLingoExcelService
@using AnkiLingoExcelService.Data

<PageTitle>AnkiLingo</PageTitle>

<TopNavigation currentCourse="currentCourse"
               courseList="courseList"
               gemsCount="userData.GemsCount"
               streakCount="userData.StreakLength"
               OnCourseChanged="LoadCourseContent"
               lastStudyDatetime="userData.LastStudy" />

<div class="d-flex flex-row gap-3">
    <SiteNavigation />

    <div id="course-content" class="w-75" style="padding-left: 20rem;">

        <div class="d-flex flex-row mb-3 gap-3">
            <div class="form-group">
                <label for="sectionSelect">Select Section:</label>

                <select id="sectionSelect" class="form-select" @bind="selectedSection">
                    @if (currentCourse != null)
                    {
                        <option value="">-- Select Section --</option>
                        foreach (var sectionData in currentCourse.Sections)
                        {
                            <option value="@sectionData.Name">@sectionData.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="form-group">
                <label for="unitSelect">Select Unit:</label>
                <select id="unitSelect" class="form-select" @bind="selectedUnit">
                    @if (currentCourse != null)
                    {
                        <option value="">-- Select Unit --</option>
                        foreach (var section in currentCourse.Sections.Where(x => !string.IsNullOrEmpty(selectedSection) && x.Name == selectedSection))
                        {
                            foreach (var unit in section.Units)
                            {
                                <option value="@unit.Name">@unit.Name</option>
                            }
                        }
                    }
                </select>

            </div>

            <div class="form-group">
                <label for="knowledgeSelect">Knowledge Level:</label>
                <select id="knowledgeSelect" class="form-select" @bind="selectedLevel">
                    <option value="">-- Select Level --</option>
                    <option value="0">0 - New</option>
                    <option value="1">1 - Very Low</option>
                    <option value="2">2 - Low</option>
                    <option value="3">3 - Medium</option>
                    <option value="4">4 - Good</option>
                    <option value="5">5 - Very Good</option>
                    <option value="6">6 - Excellent</option>
                    <option value="7">7 - Mastered</option>
                    <option value="8">8 - Perfect</option>
                    <option value="9">9 - Legendary</option>
                    <option value="10">10 - Immortal</option>
                </select>
            </div>

            <button class="btn btn-primary mt-4" @onclick="FilterContent">Filter</button>
            @if (!string.IsNullOrEmpty(selectedSection) && !string.IsNullOrEmpty(selectedUnit))
            {
                <button class="btn btn-secondary mt-4" @onclick="StartStudySession">Study</button>
            }

            <button class="btn btn-primary mt-4" @onclick="LoadImages">Load Images</button>
            <button class="btn btn-secondary mt-4" @onclick="() => {images.Clear(); currentImage = null;}">Clear Images</button>
        </div>

        @if (currentImage != null)
        {
            <div class="d-flex flex-row gap-3 mb-3">

                <div class="form-group">
                    <label for="selected-image">Selected Image</label>
                    <select id="selected-image" class="form-select" @bind="currentImageName">
                        @if (images != null && images.Count() > 0)
                        {
                            @foreach (ImageData img in images)
                            {
                                <option value="@img.ImageName">@img.ImageName</option>
                            }
                        }
                    </select>
                    <button class="btn btn-secondary mt-2" @onclick="RedrawImageWithCoversAsync">Redraw Image with Covers</button>
                </div>

                <div class="form-group">
                    <lable for="max-width">Max Width:</lable>"
                    <input id="max-width" type="number" class="form-control" style="width: 100px;" @bind="currentImageMaxWidth" />
                </div>

                <div class="form-group">
                    <lable for="max-height">Max Height:</lable>"
                    <input id="max-height" type="number" class="form-control" style="width: 100px;" @bind="currentImageMaxHeight" />
                </div>

                <div class="form-group mb-2">
                    <label for="coverText">Text to associate with next cover:</label>
                    <input id="coverText" class="form-control" style="width: 300px;" @bind="coverText" />
                </div>
                <button class="btn btn-primary" @onclick="SaveImage">Save</button>
            </div>

            @if (currentImage != null)
            {
                <div style="position: relative; display: inline-block;">
                    <img id="mainImage" src="@imagePath" alt="@currentImage.ImageName"
                         style="max-width: @(currentImageMaxWidth)px; max-height: @(currentImageMaxHeight)px;" />
                    <canvas id="drawCanvas"
                            width="@currentImageMaxWidth"
                            height="@currentImageMaxHeight"
                            style="position: absolute; top: 0; left: 0; pointer-events: auto;"
                            @onmousedown="OnMouseDown"
                            @onmousemove="OnMouseMove"
                            @onmouseup="OnMouseUp"></canvas>
                </div>

                <ul>
                    @foreach (var cover in currentImage.ImageCovers)
                    {
                        <li>Cover: @cover.Value (@cover.StartX, @cover.StartY, @cover.EndX, @cover.EndY)</li>
                    }
                </ul>
            }
        }
        else
        {
            <ul class="d-flex flex-row flex-wrap gap-4">
                @foreach (var entry in Entries)
                {
                    <li class="list-group-item w-25 p-3 border rounded-2 shadow">
                        @switch (entry.LevelOfKnowledge)
                        {
                            case 0:
                                <h6 class="badge bg-danger">@entry.LevelOfKnowledge</h6>
                                break;
                            case 1:
                                <h6 class="badge bg-danger">@entry.LevelOfKnowledge</h6>
                                break;
                            case 2:
                                <h6 class="badge bg-danger">@entry.LevelOfKnowledge</h6>
                                break;
                            case 3:
                                <h6 class="badge bg-warning">@entry.LevelOfKnowledge</h6>
                                break;
                            case 4:
                                <h6 class="badge bg-warning">@entry.LevelOfKnowledge</h6>
                                break;
                            case 5:
                                <h6 class="badge bg-warning">@entry.LevelOfKnowledge</h6>
                                break;
                            case 6:
                                <h6 class="badge bg-success">@entry.LevelOfKnowledge</h6>
                                break;
                            case 7:
                                <h6 class="badge bg-success">@entry.LevelOfKnowledge</h6>
                                break;
                            case 8:
                                <h6 class="badge bg-success">@entry.LevelOfKnowledge</h6>
                                break;
                            default:
                                <h6 class="badge bg-success">@entry.LevelOfKnowledge</h6>
                                break;
                        }

                        <strong> @entry.Value1</strong> - @entry.Value2
                        <br /> Last Reviewed:
                        @if (entry.LastReviewed.Year < 1900)
                        {
                            <small>never</small>
                        }
                        else
                        {
                            <small>@entry.LastReviewed.ToShortDateString()</small>
                        }
                    </li>
                }
            </ul>

        }
        <StudyComponent @ref="studyComponentRef"
                        Entries="StudyContent"
                        Show="showStudyModal"
                        OnClose="CloseStudyModal"
                        OnUpdateEntry="(entry) => UpdateEntry(entry.Value1, entry.Value2, entry.LevelOfKnowledge)"
                        CurrentCourse="currentCourse" />

    </div>
</div>

@code {
    private List<string> courseList = new List<string>();
    private List<EntryData> Entries { get; set; } = new List<EntryData>();
    private List<EntryData> StudyContent { get; set; } = new List<EntryData>();
    private string errorMessage;
    private UserData userData;
    private CourseData currentCourse;
    private string selectedSection { get; set; }
    private string selectedUnit { get; set; }
    private string selectedLevel { get; set; }
    private List<string> BackgroundColours = new List<string>()
    {
    "#FFCDD2", "#F8BBD0", "#E1BEE7", "#D1C4E9", "#C5CAE9","#BBDEFB", "#B3E5FC", "#B2EBF2", "#B2DFDB", "#C8E6C9",
    "#DCEDC8", "#F0F4C3", "#FFF9C4", "#FFECB3", "#FFE0B2", "#FFCCBC", "#D7CCC8", "#CFD8DC", "#E0E0E0", "#FAFAFA"
    };
    private string selectedCourse { get; set; }

    private bool showStudyModal = false;
    private StudyComponent studyComponentRef;

    private List<ImageData> images = new List<ImageData>();
    private ImageData currentImage;
    private string currentImageName;
    private string imagePath => currentCourse != null ? $"images/{currentImage.ImageName}.jpg" : "images/course.png";
    private int currentImageMaxWidth = 1000;
    private int currentImageMaxHeight = 1000;
    private string coverText = "";

    #region drawing mode

    private bool isDrawing = false;
    private double startX, startY, endX, endY;

    private async Task OnMouseDown(MouseEventArgs e)
    {
        isDrawing = true;
        startX = e.OffsetX;
        startY = e.OffsetY;
    }

    private async Task OnMouseMove(MouseEventArgs e)
    {
        if (isDrawing)
        {
            endX = e.OffsetX;
            endY = e.OffsetY;
            await DrawRectangle();
        }
    }

    private async Task OnMouseUp(MouseEventArgs e)
    {
        isDrawing = false;
        endX = e.OffsetX;
        endY = e.OffsetY;
        currentImage.ImageCovers.Add(new ImageCover
        {
            StartX = (int)startX,
            StartY = (int)startY,
            EndX = (int)endX,
            EndY = (int)endY,
            Value = coverText
        });

        coverText = "";        
        await RedrawImageWithCoversAsync();
    }

    private async Task RedrawImageWithCoversAsync()
    {
        if (currentImage == null) return;

        currentImage = images.FirstOrDefault(i => i.ImageName == currentImageName);
        if (currentImage == null) return;

        var covers = currentImage.ImageCovers.Select(c => new {
            startX = c.StartX,
            startY = c.StartY,
            endX = c.EndX,
            endY = c.EndY
        }).ToList();
        await JS.InvokeVoidAsync("drawImageWithCovers", "mainImage", "drawCanvas", covers);
    }

    @inject IJSRuntime JS

    @code {
        // ... existing code ...

        private async Task DrawRectangle()
        {
            // Use JS interop to draw on the canvas
            await JS.InvokeVoidAsync("drawRectOnCanvas", startX, startY, endX - startX, endY - startY);
        }

        // ... existing code ...
    }

    #endregion 

    protected override async Task OnInitializedAsync()
    {
    try
    {
        var userDataFilePath = @"C:\temp\AnkiLingo\Data\UserData.xlsx";
        userData = ExcelService.GetUserData(userDataFilePath);
        courseList = ExcelService.GetCourseNames(@"C:\temp\AnkiLingo");
        selectedCourse = userData.CurrentCourse;
        LoadCourseContent(userData.CurrentCourse);
    }
    catch (Exception ex)
    {
        // Handle exceptions, e.g., log them or show a message to the user
        Console.WriteLine($"Error fetching course list: {ex.Message}");
        errorMessage = "Failed to load course list. Please check the console for details.";
    }
    }

    protected void FilterContent()
    {
    Entries.Clear();
    LoadCourseContent(selectedCourse);
    }

    protected void LoadCourseContent(string courseName)
    {
    try
    {
        var filePath = @"C:\temp\AnkiLingo";
        var currentCoursePath = $"{filePath}\\{courseName}.xlsx";
        currentCourse = ExcelService.GetCourseDetails(currentCoursePath);

        foreach (UnitData unit in currentCourse.Sections.SelectMany(s => s.Units))
        {
            unit.BackgroundColor = BackgroundColours[new Random().Next(BackgroundColours.Count)];
        }

        userData.CurrentCourse = courseName;

        // add all entries from all sections and units to Entries
        foreach (var section in currentCourse.Sections)
        {
            if (!string.IsNullOrEmpty(selectedSection) && section.Name != selectedSection)
            {
                continue; // Skip sections that don't match the selected section
            }

            foreach (var unit in section.Units)
            {
                if (!string.IsNullOrEmpty(selectedUnit) && unit.Name != selectedUnit)
                {
                    continue; // Skip units that don't match the selected unit
                }

                Entries.AddRange(unit.Entries.Where(x => x.LastReviewed.Year > 1901 &&
                                                        (string.IsNullOrEmpty(selectedLevel) || x.LevelOfKnowledge.ToString().Equals(selectedLevel))));
            }
        }

        ExcelService.UpdateUserData(@"C:\temp\AnkiLingo\Data\UserData.xlsx", userData);
        StateHasChanged();
    }
    catch (Exception ex)
    {
        // Handle exceptions, e.g., log them or show a message to the user
        Console.WriteLine($"Error loading course content: {ex.Message}");
        errorMessage = "Failed to load course content. Please check the console for details.";
    }
    }

    protected void StartStudySession()
    {
    StudyContent.Clear();
    StudyContent = Entries
        .Where(x => x.LastReviewed.Year > 1901)
        .OrderBy(x => Guid.NewGuid()) // Randomize the order
        .ToList();
    showStudyModal = true;

    StateHasChanged();
    }

    protected void CloseStudyModal()
    {
    StudyContent.Clear();
    showStudyModal = false;
    StateHasChanged();
    }

    protected void UpdateEntry(string value1, string value2, int levelOfKnowledge)
    {
    if (levelOfKnowledge > 10) levelOfKnowledge = 10;
    if (levelOfKnowledge < 0) levelOfKnowledge = 0;

    var filePath = @"C:\temp\AnkiLingo";
    var currentCoursePath = $"{filePath}\\{currentCourse.Name}.xlsx";
    ExcelService.UpdateEntry(currentCoursePath, selectedSection, selectedUnit, value1, value2, levelOfKnowledge);
    }

    protected async Task LoadImages()
    {
        var filePath = @"C:\temp\AnkiLingo";
        var currentCoursePath = $"{filePath}\\{currentCourse.Name}.xlsx";

        images = ExcelService.GetImages(currentCoursePath);

        // filter images to only those that have entries in the current section and unit
        if (!string.IsNullOrEmpty(selectedSection) && !string.IsNullOrEmpty(selectedUnit))
        {
            images = images.Where( x => x.SectionName == selectedSection && x.UnitName == selectedUnit).ToList();
        }

        currentImage = images[0];
        currentImageName = currentImage.ImageName;
        await RedrawImageWithCoversAsync();
    }

    protected void SaveImage()
    {
        if (currentImage == null) return;
        var filePath = @"C:\temp\AnkiLingo";
        var currentCoursePath = $"{filePath}\\{currentCourse.Name}.xlsx";
        ExcelService.SaveImageData(currentCoursePath, currentImage);
    }
}

<script>
window.drawRectOnCanvas = (x, y, w, h) => {
    const canvas = document.getElementById('drawCanvas');
    const ctx = canvas.getContext('2d');
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.strokeStyle = 'red';
    ctx.lineWidth = 2;
    ctx.strokeRect(x, y, w, h);
};

window.drawImageWithCovers = (imageId, canvasId, covers) => {
    const img = document.getElementById(imageId);
    const canvas = document.getElementById(canvasId);
    if (!img || !canvas) return;
    const ctx = canvas.getContext('2d');

    // Get the actual displayed size of the image
    const displayWidth = img.width;
    const displayHeight = img.height;

    // Resize canvas to match image display size
    canvas.width = displayWidth;
    canvas.height = displayHeight;

    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.drawImage(img, 0, 0, displayWidth, displayHeight);

    ctx.fillStyle = 'rgba(0,0,0,1)';
    covers.forEach(c => {
        ctx.fillRect(c.startX, c.startY, c.endX - c.startX, c.endY - c.startY);
    });
};
</script>
